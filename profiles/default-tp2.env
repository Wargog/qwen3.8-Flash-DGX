# desc: TP=2 across two DGX Sparks over RoCE — hybrid + fp8 KV + YaRN 500k (see docs/MULTI-NODE-TP2.md)
TP_SIZE=2
MODE=hybrid
CTX=500000
YARN=1
SEQS=8
GPU_MEM=0.80
KV_DTYPE=fp8_e4m3
MTP=3
DRAFT_VOCAB=0
MAMBA_SSM_DTYPE=bfloat16
BATCH_TOKENS=8192
PREFIX_CACHE=1
EAGER=1
PLE_MMAP=0
EFFORT_ALIAS=1
SPLIT_PREFILL=1
MASTER_PORT=29500
PORT=18300
# --- fabric: EDIT this block on the head; read real values with `ip -br addr` / `ls /sys/class/infiniband` (docs §3.1) ---
MASTER_ADDR=10.100.0.1
PEER=user@10.100.0.2
NCCL_SOCKET_IFNAME=enp1s0f0np0
NCCL_IB_HCA=rocep1s0f0,roceP2p1s0f0
ROCE_SUBNET=10.100.0.0/24
