# desc: EXPERIMENTAL TP=2 across two DGX Sparks over RoCE (see docs/MULTI-NODE-TP2.md)
#
# This profile is read by scripts/serve-tp2.sh, not by ./flash serve (a single
# container cannot join a multi-node mp group; serve.sh refuses TP_SIZE>1).
# It was primarily written by an AI agent from issue #52, the x00byte and
# capetron dual-Spark recipes and the NVIDIA playbooks; the settings have since
# been validated end-to-end on a live TP2 pair (launch, §3.7 gates, benches -
# see docs/MULTI-NODE-TP2.md section 7). The fabric block at the bottom is
# placeholder - EDIT it on your head node.
#
# Comments must stay whole-line: flash's profile loader does not strip inline ones.
TP_SIZE=2
MODE=nvfp4
# native 262k by default. YaRN to ~500k is WIRED in serve-tp2.sh (YARN=1 +
# higher CTX; same factor-4 recipe as single-node) but has never RUN on TP -
# highest-reward upgrade in docs/MULTI-NODE-TP2.md section 7; gate on
# retrieval at CTX + greedy-probe before trusting it. (MODE=hybrid still fails
# to load at TP>1: shared_expert 640/2=320 vs fp8 block_n 128, issue #52.)
CTX=262144
YARN=0
SEQS=8
# 0.80 keeps each box above a ~15% MemAvailable floor on the unified pool;
# >=0.85 is how the community guides got OOM-killed (capetron memory section).
GPU_MEM=0.80
# bf16 KV = the quality path this repo validated single-node; fp8_e4m3 buys
# ~1.6x the pool at a cost, try it only after an eager bf16 run is stable.
KV_DTYPE=auto
# x00byte/capetron ran MTP-4 on TP2; #52 ran MTP-2. No DRAFT_VOCAB pruning:
# it crashes at TP>1 (global ids vs the row-sharded lm_head, issue #52).
MTP=4
DRAFT_VOCAB=0
MAMBA_SSM_DTYPE=bfloat16
# 32768 measured *worse* at TP2: prefill 1815->1444 tok/s, KV 1.43M->906k (#52).
BATCH_TOKENS=8192
PREFIX_CACHE=1
# First bring-up uses --enforce-eager (multi-node GB10 CUDA-graph capture has
# hard-locked nodes in the community reports). Flip to 0 only after a validated
# eager run; #52 ran piecewise graphs at TP2 successfully.
EAGER=1
# The PLE mmap hook gathers global rows and is untested under TP; the resident
# table fits fine once the rest of the checkpoint is split across two boxes.
PLE_MMAP=0
# Serve the rewritten chat template that maps reasoning_effort high/max -> xhigh
# and minimal -> low (the stock NVIDIA template 400s on them; Claude Code sends high).
EFFORT_ALIAS=1
# The v0.33 checkpoint-boundary prefix-cache workaround (patch 24) - the same
# knob the single-node prefix-cache-safe profile uses. The first live TP2 pair
# failed the docs 3.7 first-token-logprob identity check cold-vs-cached with this
# off (greedy text stayed identical - scoring-path drift only) and passed
# bit-identical with it on (docs 7.7), so it is the default here. Set 0 only to
# A-B the cache path.
SPLIT_PREFILL=1
MASTER_PORT=29500
PORT=18300

# --- fabric + addresses: EDIT this block on the node you launch from (the head) --
# The launcher reads everything from here; no env vars on the command line
# (shell env still overrides for ad-hoc runs). Keep the rest of the checkout
# identical on both boxes (same commit); only this block needs to be correct on
# the head, because only the head runs serve-tp2.sh.
# If the pair was set up with the NVIDIA Sync Cluster Assistant, the ConnectX-7
# interfaces ALREADY have preset 10.100.x.x addresses (see
# /etc/netplan/99-nvidia-sync-cluster.yaml) — read yours with `ip -br addr` and
# put them here; do not add another subnet on top. The values below are
# placeholders; the launch preflight fails fast, naming the node, if they don't
# match reality.
# MASTER_ADDR = this node's own fabric IP (the one the worker can reach)
# PEER        = passwordless-ssh target of the worker: user@<worker-fabric-ip>
# ROCE_SUBNET = the CIDR those two addresses share. Two QSFP links may sit in
# different /24s — a supernet (e.g. /22) covering both is valid.
MASTER_ADDR=10.100.0.1
PEER=user@10.100.0.2
# (VLLM_HOST_IP is derived per rank from these two - docs 1. #14)
# ls /sys/class/infiniband   -> NCCL_IB_HCA    (default lists both; keep only
# one if the pair has a single QSFP)
# ip a                       -> NCCL_SOCKET_IFNAME (the CX-7 interface)
NCCL_SOCKET_IFNAME=enp1s0f0np0
# Both rails by default, verified on a live pair 2026-11-20: NCCL striped near
# evenly across both HCAs (1,694 vs 1,616 MiB per ~10k-token prefill burst).
# Verify any instance from the IB port counters below - NOT netdev stats,
# which are blind to GPU-direct RDMA traffic. port_*_data are 4-byte words,
# 32-bit (handle wrap), sampled before/after a prefill burst:
#   /sys/class/infiniband/<dev>/ports/1/counters/port_xmit_data (and _rcv_)
NCCL_IB_HCA=rocep1s0f0,roceP2p1s0f0
# NCCL_IB_GID_INDEX is deliberately NOT set. Pinned GID indices drift when one
# node reboots alone or an address is added/removed (MiaAI-Lab dual-Spark #73),
# so serve-tp2.sh lets NCCL resolve the RoCEv2 GID from ROCE_SUBNET per rank and
# preflights both nodes' GID tables at launch.
ROCE_SUBNET=10.100.0.0/24
