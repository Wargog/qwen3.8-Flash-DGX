# desc: TP=2 hybrid (fp8 side layers, #52 shared-experts carveout), MTP3 like the repo hybrid default
#
# Same TP=2 lane as default-tp2.env (read by scripts/serve-tp2.sh, not by
# ./flash serve), but serves the -fp8hybrid layout: dense side layers as
# blockwise fp8, MoE experts NVFP4 as published (#52: +32..42% decode, -20% TTFT
# on a live pair). PREREQUISITE: prepare the layout ON THE HEAD WITH THE
# CARVEOUT - ./flash setup hybrid-tp2 does it automatically (it loads this
# profile, sees TP_SIZE>1, and leaves mlp.shared_expert.* bf16; converted to
# fp8 they are 640 wide -> 320/rank and vLLM's blockwise-fp8 loader refuses
# them at TP=2, issue #52). Then rsync the whole HF cache to the worker:
# serve-tp2.sh preflights both nodes' index files and names the offender.
#
# MTP=3 mirrors the repo's current default hybrid recipe (default.env ->
# mtp-fast.env, "MTP3 NVFP4 proposal head"). Deliberately NOT mirrored from
# mtp-fast: MTP_DRAFT_QUANT=nvfp4 (needs the V2 runner - never run on two
# nodes), 16k BATCH_TOKENS and fixed KV_CACHE_MEM (KV_CACHE_MEM is not wired
# in serve-tp2.sh at all; #52 measured 32k batch WORSE at TP2). fp8 KV IS
# mirrored: it became the default-tp2 default 2026-11-20 after measured gates
# on the nvfp4 lane (+78% pool; costs + caveats commented in default-tp2.env).
# Those gates ran on nvfp4 MODE, so first hybrid bring-up re-gates before
# trust: ./flash wait + scripts/greedy-probe.sh x2 + tp2-needle 150k.
# First bring-up stays conservative otherwise: native ctx, eager.
#
# Comments must stay whole-line: the profile loader does not strip inline ones.
TP_SIZE=2
MODE=hybrid
CTX=262144
YARN=0
SEQS=8
GPU_MEM=0.80
KV_DTYPE=fp8_e4m3
MTP=3
DRAFT_VOCAB=0
MAMBA_SSM_DTYPE=bfloat16
BATCH_TOKENS=8192
PREFIX_CACHE=1
EAGER=1
PLE_MMAP=0
EFFORT_ALIAS=1
SPLIT_PREFILL=1
MASTER_PORT=29500
PORT=18300

# --- fabric + addresses: EDIT this block on the node you launch from (the head) --
# Identical to default-tp2.env (see the notes there): the NVIDIA Sync Cluster
# Assistant presets 10.100.x.x addresses - read yours with `ip -br addr`.
# Placeholders below; the launch preflight fails fast, naming the node, if they
# do not match reality.
MASTER_ADDR=10.100.0.1
PEER=user@10.100.0.2
NCCL_SOCKET_IFNAME=enp1s0f0np0
NCCL_IB_HCA=rocep1s0f0,roceP2p1s0f0
ROCE_SUBNET=10.100.0.0/24
